              "type": "EVENT_THIS_TURN",
              "event": "transcend"
            }
          ],
          "then": [
            {
              "type": "MODIFY_NEXT_ATTACK",
              "mod": "add",
              "amount": 5,
              "filter": [
                {
                  "type": "ATTACK_NAME_IN",
                  "names": [
                    "crouching_tiger"
                  ]
                }
              ]
            }
          ],
          "else": [
            {
              "type": "MODIFY_NEXT_ATTACK",
              "mod": "add",
              "amount": 3,
              "filter": [
                {
                  "type": "ATTACK_NAME_IN",
                  "names": [
                    "crouching_tiger"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "GO_AGAIN"
        }
      ]
    }
  ]
